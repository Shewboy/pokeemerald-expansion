mapscripts ProdemiaCity_Frlg_MapScripts {
    MAP_SCRIPT_ON_LOAD: ProdemiaCity_OnLoad
    MAP_SCRIPT_ON_TRANSITION: ProdemiaCity_OnTransition
}


### STORY EVENTS


script ProdemiaCity_OnTransition {
    if (var(VAR_PRODEMIA_CITY_STATE) == 0) {
        clearflag(FLAG_HIDE_PRODEMIA_UMBRA_GRUNTS)
        setflag(FLAG_HIDE_PRODEMIA_UMBRA_THIEF)
        setflag(FLAG_HIDE_SALLY_HOLLY_PRODEMIA)
    }
    elif (var(VAR_PRODEMIA_CITY_STATE) == 1) {
        setflag(FLAG_HIDE_PRODEMIA_UMBRA_GRUNTS)
        clearflag(FLAG_HIDE_PRODEMIA_UMBRA_THIEF)
        setflag(FLAG_HIDE_SALLY_HOLLY_PRODEMIA)
    }
    else {
        setflag(FLAG_HIDE_PRODEMIA_UMBRA_GRUNTS)
        setflag(FLAG_HIDE_PRODEMIA_UMBRA_THIEF)
        setflag(FLAG_HIDE_SALLY_HOLLY_PRODEMIA)
    }
}

script ProdemiaCity_EventScript_UmbraGruntM {
    lock
    msgbox(format("Mutter mutter mutter..."))
    faceplayer
    msgbox(format("Hey kid, can't you see we're busy scheming? Get lost!"))
    applymovement(23, moves(face_up))
    waitmovement
    release
}

script ProdemiaCity_EventScript_UmbraGruntF {
    lock
    msgbox(format("Whisper whisper whisper..."))
    faceplayer
    msgbox(format("Tch! Stop eavesdropping! Scram!"))
    applymovement(22, moves(face_down))
    waitmovement
    release
}

script ProdemiaCity_Trigger_ThiefBottom {
    lockall
    setvar(VAR_TEMP_1, 0)
    goto(ProdemiaCity_EventScript_Thief)
    end
}

script ProdemiaCity_Trigger_ThiefMidBottom {
    lockall
    setvar(VAR_TEMP_1, 1)
    goto(ProdemiaCity_EventScript_Thief)
    end
}

script ProdemiaCity_Trigger_ThiefMidTop {
    lockall
    setvar(VAR_TEMP_1, 2)
    goto(ProdemiaCity_EventScript_Thief)
    end
}

script ProdemiaCity_Trigger_ThiefTop {
    lockall
    setvar(VAR_TEMP_1, 3)
    goto(ProdemiaCity_EventScript_Thief)
    end
}

script ProdemiaCity_EventScript_Thief {
    playbgm(MUS_ENCOUNTER_MAGMA, TRUE)
    switch(var(VAR_TEMP_1)) {
        case 0:
            applymovement(LOCALID_PLAYER, moves(walk_up, face_left))
        case 1:
            applymovement(LOCALID_PLAYER, moves(face_left))
        case 2:
            applymovement(LOCALID_PLAYER, moves(walk_down, face_left))
        case 3:
            applymovement(LOCALID_PLAYER, moves(walk_down * 2, face_left))
    }
    waitmovement
    msgbox(format("Hehehehe! Mother is sure to be pleased with us for stealing this."))
    playse(SE_PIN)
    applymovement(24, moves(emote_question_mark))
    waitmovement
    delay(40)
    applymovement(24, moves(face_right))
    msgbox(format("Hey! This doesn't concern you.\pThe motives of the Umbra Clan are far beyond what your puny brain can comprehend.\pBut you look like you came to fight, so a fight is what you'll get!"))
    applymovement(24, moves(walk_right))
    waitmovement
    trainerbattle_no_intro(TRAINER_UMBRA_CLAN_F_PRODEMIA, format("What?! Impossible!"))
    msgbox(format("Grrr, you're stronger than you look.\pBut you're too late. My partner has the book, and he's long gone!\pThe Umbra Clan will not rest until Meddoh is engulfed in darkness!"))
    closemessage
    applymovement(24, moves(walk_left))
    waitmovement
    playse(SE_EXIT)
    removeobject(24)
    fadedefaultbgm
    delay(40)
    setvar(VAR_PRODEMIA_CITY_STATE, 2)
    goto(ProdemiaCity_EventScript_ReceivePokedex)
}

script ProdemiaCity_EventScript_ReceivePokedex {
    msgbox(format("{PLAYER}!"))
    closemessage
    addobject(25)
    addobject(26)
    applymovement(LOCALID_PLAYER, moves(face_right))
    applymovement(25, moves(walk_left * 7, walk_up * 3, face_left))
    applymovement(26, moves(walk_left * 8, walk_up * 2, face_left))
    waitmovement
    msgbox(format("SALLY: Are your Pok\emon hurt?\pHere, let me heal them."))
    call(Common_EventScript_OutOfCenterPartyHeal)
    msgbox(format("HOLLY: Judging by your expression, I assume you couldn't get the book back.\pDon't be hard on yourself, {PLAYER}. Your bravery speaks volumes!"))
    applymovement(26, moves(face_up))
    waitmovement
    msgbox(format("SALLY: Professor, who was that hooded thief? And why do they want that book?"))
    applymovement(25, moves(face_down))
    waitmovement
    msgbox(format("HOLLY: I'm not sure, Sally. I can't say I've even noticed a book like that in the library."))
    applymovement(25, moves(face_left))
    applymovement(26, moves(face_left))
    waitmovement
    msgbox(format("HOLLY: Regardless! {PLAYER}, I've just met you, but your actions today have proven to me that you are more than deserving of this."))
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox(format("Received the Pok\edex!"))
    waitmessage
    waitfanfare
    setflag(FLAG_SYS_POKEDEX_GET)
    msgbox(format("SALLY: Wow, a real Pok\edex!"))
    applymovement(25, moves(face_down))
    applymovement(26, moves(face_up))
    msgbox(format("HOLLY: Sally, I stand by what I said earlier. You're ready to embark on a journey of your own. You take one as well."))
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox(format("Sally received the Pok\edex!"))
    waitmessage
    waitfanfare
    msgbox(format("SALLY: Th-thank you, Professor! I'll make you proud!"))
    msgbox(format("HOLLY: You already have, my dear!"))
    applymovement(25, moves(face_left))
    waitmovement
    msgbox(format("HOLLY: My mission to you both is to record as much information on Pok\emon as you can.\pExplore every inch of the Meddoh region and take in all that it has to offer.\pBut most importantly, have fun! And support each other when you can."))
    msgbox(format("SALLY: We will, Professor!"))
    applymovement(26, moves(face_left))
    waitmovement
    msgbox(format("SALLY: {PLAYER}, I've read that one of the best ways to learn about Pok\emon is through battling.\pMaybe we can plan to meet up and battle each other on our journeys. Sorta like rivals!"))
    msgbox(format("HOLLY: That's a wonderful idea, Sally! Nothing like a little friendly competition to keep you motivated.\pWhile we're on the subject, you can also take on the Meddoh League. The first gym is just to the west of here, in Grodeo Town."))
    msgbox(format("SALLY: Sounds like a plan! Come to Route 2 once you're ready, {PLAYER}!"))
    closemessage
    applymovement(26, moves(walk_left * 2, walk_up, walk_left))
    waitmovement
    playse(SE_EXIT)
    removeobject(26)
    delay(40)
    msgbox(format("HOLLY: I've never seen her so excited!\p{PLAYER}, do watch out for her, will you? She's a smart girl, but a bit sheltered.\pA fault of my own overprotectiveness, I suppose.\pAnyway, best of luck to you. I look forward to hearing about your accomplishments!"))
    closemessage
    applymovement(25, moves(walk_down * 3, walk_right * 7))
    waitmovement
    removeobject(25)
    setvar(VAR_PRODEMIA_CITY_STATE, 3)
    delay(40)
    releaseall
}

script ProdemiaCity_OnLoad {
    if (flag(FLAG_BADGE03_GET)){
        //Replace crane tiles with tan brick tiles
        setmetatile(32, 33, METATILE_ProdemiaCity_TanBrick, FALSE)
        setmetatile(33, 33, METATILE_ProdemiaCity_TanBrick, FALSE)
        setmetatile(34, 33, METATILE_ProdemiaCity_TanBrick, FALSE)
        setmetatile(32, 32, METATILE_ProdemiaCity_TanBrick, FALSE)
        setmetatile(33, 32, METATILE_ProdemiaCity_TanBrick, FALSE)
        setmetatile(34, 32, METATILE_ProdemiaCity_TanBrick, FALSE)
        setmetatile(34, 31, METATILE_ProdemiaCity_TanBrick, FALSE)
        setmetatile(33, 29, METATILE_ProdemiaCity_TanBrick, FALSE)
        setmetatile(34, 29, METATILE_ProdemiaCity_TanBrick, FALSE)
        setmetatile(33, 28, METATILE_ProdemiaCity_TanBrick, FALSE)
        setmetatile(34, 28, METATILE_ProdemiaCity_TanBrick, FALSE)
        //Build one row of mall
        setmetatile(41, 30, METATILE_ProdemiaCity_PokeMall_CenterWindow, TRUE)
        setmetatile(42, 30, METATILE_ProdemiaCity_PokeMall_CenterWindow, TRUE)
        setmetatile(43, 30, METATILE_ProdemiaCity_PokeMall_CenterWindow, TRUE)
        setmetatile(44, 30, METATILE_ProdemiaCity_PokeMall_CenterWindow, TRUE)
        setmetatile(45, 30, METATILE_ProdemiaCity_PokeMall_CenterWindow, TRUE)
        setmetatile(46, 30, METATILE_ProdemiaCity_PokeMall_CenterWindow, TRUE)
        setmetatile(47, 30, METATILE_ProdemiaCity_PokeMall_CenterWindow, TRUE)
        setmetatile(48, 30, METATILE_ProdemiaCity_PokeMall_RightWindow, TRUE)
        setmetatile(49, 30, METATILE_ProdemiaCity_PokeMall_RightWall, TRUE)
        //Build next row of mall (top floor)
        setmetatile(35, 29, METATILE_ProdemiaCity_PokeMall_LeftWall_Top, TRUE)
        setmetatile(36, 29, METATILE_ProdemiaCity_PokeMall_LeftWindow_Top, TRUE)
        setmetatile(37, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(38, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(39, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(40, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(41, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(42, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(43, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(44, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(45, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(46, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(47, 29, METATILE_ProdemiaCity_PokeMall_CenterWindow_Top, TRUE)
        setmetatile(48, 29, METATILE_ProdemiaCity_PokeMall_RightWindow_Top, TRUE)
        setmetatile(49, 29, METATILE_ProdemiaCity_PokeMall_RightWall_Top, TRUE)
        //Build first row of roof
        setmetatile(35, 28, METATILE_ProdemiaCity_PokeMall_LeftRoof_Bottom, TRUE)
        setmetatile(36, 28, METATILE_ProdemiaCity_PokeMall_CenterRoof_Bottom, TRUE)
        setmetatile(37, 28, METATILE_ProdemiaCity_PokeMall_LeftSky_Bottom, TRUE)
        setmetatile(38, 28, METATILE_ProdemiaCity_PokeMall_CenterSky_Bottom, TRUE)
        setmetatile(39, 28, METATILE_ProdemiaCity_PokeMall_RightSky_Bottom, TRUE)
        setmetatile(40, 28, METATILE_ProdemiaCity_PokeMall_CenterRoof_Bottom, TRUE)
        setmetatile(41, 28, METATILE_ProdemiaCity_PokeMall_LeftSky_Bottom, TRUE)
        setmetatile(42, 28, METATILE_ProdemiaCity_PokeMall_CenterSky_Bottom, TRUE)
        setmetatile(43, 28, METATILE_ProdemiaCity_PokeMall_RightSky_Bottom, TRUE)
        setmetatile(44, 28, METATILE_ProdemiaCity_PokeMall_CenterRoof_Bottom, TRUE)
        setmetatile(45, 28, METATILE_ProdemiaCity_PokeMall_LeftSky_Bottom, TRUE)
        setmetatile(46, 28, METATILE_ProdemiaCity_PokeMall_CenterSky_Bottom, TRUE)
        setmetatile(47, 28, METATILE_ProdemiaCity_PokeMall_RightSky_Bottom, TRUE)
        setmetatile(48, 28, METATILE_ProdemiaCity_PokeMall_CenterRoof_Bottom, TRUE)
        setmetatile(49, 28, METATILE_ProdemiaCity_PokeMall_RightRoof_Bottom, TRUE)
        //Build second row of roof
        setmetatile(35, 27, METATILE_ProdemiaCity_PokeMall_LeftRoof_Middle, TRUE)
        setmetatile(36, 27, METATILE_ProdemiaCity_PokeMall_CenterRoof_Middle, TRUE)
        setmetatile(37, 27, METATILE_ProdemiaCity_PokeMall_LeftSky_Middle, TRUE)
        setmetatile(38, 27, METATILE_ProdemiaCity_PokeMall_CenterSky_Middle, TRUE)
        setmetatile(39, 27, METATILE_ProdemiaCity_PokeMall_RightSky_Middle, TRUE)
        setmetatile(40, 27, METATILE_ProdemiaCity_PokeMall_CenterRoof_Middle, TRUE)
        setmetatile(41, 27, METATILE_ProdemiaCity_PokeMall_LeftSky_Middle, TRUE)
        setmetatile(42, 27, METATILE_ProdemiaCity_PokeMall_CenterSky_Middle, TRUE)
        setmetatile(43, 27, METATILE_ProdemiaCity_PokeMall_RightSky_Middle, TRUE)
        setmetatile(44, 27, METATILE_ProdemiaCity_PokeMall_CenterRoof_Middle, TRUE)
        setmetatile(45, 27, METATILE_ProdemiaCity_PokeMall_LeftSky_Middle, TRUE)
        setmetatile(46, 27, METATILE_ProdemiaCity_PokeMall_CenterSky_Middle, TRUE)
        setmetatile(47, 27, METATILE_ProdemiaCity_PokeMall_RightSky_Middle, TRUE)
        setmetatile(48, 27, METATILE_ProdemiaCity_PokeMall_CenterRoof_Middle, TRUE)
        setmetatile(49, 27, METATILE_ProdemiaCity_PokeMall_RightRoof_Middle, TRUE)
        //Build final row of roof
        setmetatile(35, 26, METATILE_ProdemiaCity_PokeMall_LeftRoof_Top, FALSE)
        setmetatile(36, 26, METATILE_ProdemiaCity_PokeMall_CenterRoof_Top, FALSE)
        setmetatile(37, 26, METATILE_ProdemiaCity_PokeMall_LeftSky_Top, FALSE)
        setmetatile(38, 26, METATILE_ProdemiaCity_PokeMall_CenterSky_Top, FALSE)
        setmetatile(39, 26, METATILE_ProdemiaCity_PokeMall_RightSky_Top, FALSE)
        setmetatile(40, 26, METATILE_ProdemiaCity_PokeMall_CenterRoof_Top, FALSE)
        setmetatile(41, 26, METATILE_ProdemiaCity_PokeMall_LeftSky_Top, FALSE)
        setmetatile(42, 26, METATILE_ProdemiaCity_PokeMall_CenterSky_Top, FALSE)
        setmetatile(43, 26, METATILE_ProdemiaCity_PokeMall_RightSky_Top, FALSE)
        setmetatile(44, 26, METATILE_ProdemiaCity_PokeMall_CenterRoof_Top, FALSE)
        setmetatile(45, 26, METATILE_ProdemiaCity_PokeMall_LeftSky_Top, FALSE)
        setmetatile(46, 26, METATILE_ProdemiaCity_PokeMall_CenterSky_Top, FALSE)
        setmetatile(47, 26, METATILE_ProdemiaCity_PokeMall_RightSky_Top, FALSE)
        setmetatile(48, 26, METATILE_ProdemiaCity_PokeMall_CenterRoof_Top, FALSE)
        setmetatile(49, 26, METATILE_ProdemiaCity_PokeMall_RightRoof_Top, FALSE)
        //Change Poke Mart door to one without Door metatile behavior.
        //This keeps the door looking identical, but effectively removes the warp.
        setmetatile(44, 22, METATILE_ProdemiaCity_PokeMart_ClosedDoor, TRUE)
        //Change Poke Mall doors to ones with Door metatile behavior.
        //This keeps the door looking identical, but effectively adds the warps.
        setmetatile(39, 33, METATILE_ProdemiaCity_SilphCoDoor, TRUE)
        setmetatile(45, 33, METATILE_ProdemiaCity_SilphCoDoor, TRUE)
        //Redraw the map
        special(DrawWholeMapView)
    }
}

### SIGNS


script ProdemiaCity_EventScript_ProdemiaUniversitySign {
    lock
    msgbox(format("Prodemia University\l\qoThe brightest minds in Meddoh.\qc"), MSGBOX_SIGN)
    release
}

script ProdemiaCity_EventScript_PokeMallSign {
    lock
    if (flag(FLAG_BADGE03_GET)) {
        msgbox(format("NOW OPEN!\lThe Prodemia Pok\e Mall!\pShop til you drop!"), MSGBOX_SIGN)
    }
    else {
        msgbox(format("COMING SOON!\lThe Prodemia Pok\e Mall!\pShop til you drop!"), MSGBOX_SIGN)
    }
    release
}

script ProdemiaCity_EventScript_PokeMartSign {
    if (flag(FLAG_BADGE03_GET)) {
        lock
        msgbox(format("PERMANENTLY CLOSED\pThank you to our dedicated customers!"), MSGBOX_SIGN)
        release
    }
}

script ProdemiaCity_EventScript_CitySign {
    lock
    msgbox(format("Prodemia City\l\qoAlways moving forward.\qc"), MSGBOX_SIGN)
    release
}

script ProdemiaCity_EventScript_DormSign {
    lock
    msgbox(format("Prodemia University Dormitories"), MSGBOX_SIGN)
    release
}


### NPCs


script EventScript_ProdemiaCity_Contractor1 {
    lock
    faceplayer
    msgbox(format("You don't have a hard hat? Be careful!"))
    release
}

script EventScript_ProdemiaCity_Contractor2 {
    lock
    faceplayer
    msgbox(format("These steel girders are called \qoI\qc beams because of their shape.\pI wonder if they have beams for the other letters of the alphabet?"))
    release
}

script EventScript_ProdemiaCity_Contractor3 {
    lock
    faceplayer
    msgbox(format("Working in construction is great!\pI get to literally make my mark on the world."))
    release
}

script EventScript_ProdemiaCity_Contractor4 {
    lock
    faceplayer
    msgbox(format("What? No, the mall won't be completed for a while.\pThe Pok\e Mart is still open, though."))
    release
}

script EventScript_ProdemiaCity_Gurdurr {
    lock
    faceplayer
    playmoncry(SPECIES_GURDURR, CRY_MODE_NORMAL)
    msgbox(format("Gurr!"))
    release
}

script EventScript_ProdemiaCity_Man {
    lock
    faceplayer
    msgbox(format("You came from Shaydwell Town? I heard it's quaint there.\pBut I like the hustle and bustle. That's why I moved to Prodemia."))
    release
}

script EventScript_ProdemiaCity_WomanWest {
    lock
    faceplayer
    msgbox(format("Prodemia used to be a slow, quiet town before the University got so big.\pNow I can barely hear myself think!"))
    release
}

script EventScript_ProdemiaCity_WomanEast {
    lock
    faceplayer
    msgbox(format("You look like a Pok\emon Trainer. Have you met Professor Holly?\pI've heard she's looking for someone to help with her research."))
    release
}

script EventScript_ProdemiaCity_TrashcanGuy {
    lock
    faceplayer
    msgbox(format("I wasn't trash picking, I swear!\p.....\lAlright, you got me.\pBut don't knock it til you try it! I've found some pretty neat stuff."))
    release
}

script EventScript_ProdemiaCity_LittleGirl {
    lock
    faceplayer
    msgbox(format("College sounds like so much fun! It's like school but with more play time."))
    release
}

script EventScript_ProdemiaCity_BaldingMan {
    lock
    faceplayer
    msgbox(format("Prodemia City doesn't have a Gym Leader.\pI guess all the college students are too bookish for that kind of thing."))
    release
}

script EventScript_ProdemiaCity_Lass {
    lock
    faceplayer
    msgbox(format("I'm a huge shopper, so I'm super excited for the new Pok\e Mall to be built!"))
    release
}

script EventScript_ProdemiaCity_WomanSouth {
    lock
    faceplayer
    msgbox(format("I just got back from visiting a friend in Silicraft City.\pShe owns an art studio that sells glass flutes."))
    release
}


### TRASHCANS


script EventScript_ProdemiaCity_Trashcan1 {
    lock
    if (var(VAR_TEMP_0) == FALSE) {
        call(Common_EventScript_TrashcanEncounter)
        if (var(VAR_RESULT) == YES) {
            setvar(VAR_TEMP_0, TRUE)
        }
    }
    else {
        msgbox(format("There's a foul stench..."))
    }
    release
}

script EventScript_ProdemiaCity_Trashcan2 {
    lock
    if (var(VAR_TEMP_1) == FALSE) {
        call(Common_EventScript_TrashcanEncounter)
        setvar(VAR_TEMP_1, TRUE)
    }
    else {
        msgbox(format("There's a foul stench..."))
    }
    release
}