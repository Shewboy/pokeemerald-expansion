##### NPCs

script QuayshadeTown_EventScript_OldWoman {
    lock
    faceplayer
    msgbox(format("Bronzong Lake is so named because of an old legend.\pThe legend tells of a Bronzong who summoned a rainstorm that lasted thirty days, thus creating the lake."))
    release
}

##### Blocks path north

script QuayshadeTown_Trigger_BlockPathNorth{
    lock
    msgbox("It's not safe.")
    applymovement(OBJ_EVENT_ID_PLAYER, StopPlayer)
    waitmovement(0)
    release
}

movement StopPlayer {
    walk_down
}