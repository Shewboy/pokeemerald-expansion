        givemon(SPECIES_TYROGUE, 5)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Received Tyrogue!")
            waitfanfare
            call(NicknamePartyMon)
        }
        elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Received Tyrogue!")
            waitfanfare
            call(NicknamePartyMon)
        }
        else{
            hidemonpic
            msgbox("No more room")
        }
            msgbox(format("It feels like just yesterday you were taking your first steps! Time really does fly, huh?\pAnyway, why don't you practice battling against some of the Pok\emon in our backyard?"))
        setflag(FLAG_SYS_POKEMON_GET)
        setvar(VAR_SHAYDWELL_INTRO_STATE, 2)
        waitmessage
        release
        }
    else{
        lock
        faceplayer
        msgbox(format("I love you, bubby! You make me proud every day."))
        release
        }
}


##### NPCs


script ShaydwellTown_EventScript_OldWoman {
    lock
    faceplayer
    msgbox(format("Bronzong Lake is so named because of an old legend.\pThe legend tells of a Bronzong who summoned a rainstorm that lasted thirty days, thus creating the lake."))
    release
}

script ShaydwellTown_EventScript_Walking_Boy{
    lock
    faceplayer
    msgbox(format(".....\p..................................\p.................................................................{PAUSE 30}.{PAUSE 30}.{PAUSE 30}?"))
    // LAVA COOKIE -> FIRE STINE
    if (checkitem(ITEM_LAVA_COOKIE,1) == TRUE && !flag(FLAG_GAVE_WALKING_BOY_LAVA_COOKIE)) {
        msgbox(format("Give the walking boy your Lava Cookie?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format(".....!"))
            removeitem(ITEM_LAVA_COOKIE,1)
            giveitem(ITEM_FIRE_STONE,1)
            waitfanfare
            setflag(FLAG_GAVE_WALKING_BOY_LAVA_COOKIE)
            release
            end
        }
        else {
            msgbox(format("....."))
            release
            end
        }
    }
    // CASTELIACONE -> ICE STONE
    elif (checkitem(ITEM_CASTELIACONE,1) == TRUE && !flag(FLAG_GAVE_WALKING_BOY_CASTELIACONE)) {
        msgbox(format("Give the walking boy your Casteliacone?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format(".....!"))
            removeitem(ITEM_CASTELIACONE,1)
            giveitem(ITEM_ICE_STONE,1)
            waitfanfare
            setflag(FLAG_GAVE_WALKING_BOY_CASTELIACONE)
            release
            end
        }
        else {
            msgbox(format("....."))
            release
            end
        }
    }
    // FRESH WATER -> WATER STONE
    elif (checkitem(ITEM_FRESH_WATER,1) == TRUE && !flag(FLAG_GAVE_WALKING_BOY_FRESH_WATER)) {
        msgbox(format("Give the walking boy your Fresh Water?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format(".....!"))
            removeitem(ITEM_FRESH_WATER,1)
            giveitem(ITEM_WATER_STONE,1)
            waitfanfare
            setflag(FLAG_GAVE_WALKING_BOY_FRESH_WATER)
            release
            end
        }
        else {
            msgbox(format("....."))
            release
            end
        }
    }
    // LEMONADE -> THUNDER STONE
    elif (checkitem(ITEM_LEMONADE,1) == TRUE && !flag(FLAG_GAVE_WALKING_BOY_LEMONADE)) {
        msgbox(format("Give the walking boy your Lemonade?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format(".....!"))
            removeitem(ITEM_LEMONADE,1)
            giveitem(ITEM_THUNDERSTONE,1)
            waitfanfare
            setflag(FLAG_GAVE_WALKING_BOY_LEMONADE)
            release
            end
        }
        else {
            msgbox(format("....."))
            release
            end
        }
    }
    // RAGE CANDY BAR -> MOON STONE
    elif (checkitem(ITEM_RAGE_CANDY_BAR,1) == TRUE && !flag(FLAG_GAVE_WALKING_BOY_RAGE_CANDY_BAR)) {
        msgbox(format("Give the walking boy your Rage Candy Bar?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format(".....!"))
            removeitem(ITEM_RAGE_CANDY_BAR,1)
            giveitem(ITEM_MOON_STONE,1)
            waitfanfare
            setflag(FLAG_GAVE_WALKING_BOY_RAGE_CANDY_BAR)
            release
            end
        }
        else {
            msgbox(format("....."))
            release
            end
            }
    }
    else {
        release
    }
}   

script ShaydwellTown_EventScript_Policeman {
    lock
    face_player
    msgbox(format("We've seen a lot of criminal activity on Route 11.\pSo, we're only allowing trainers with at least seven badges to pass."))
    release
}

script ShaydwellTown_EventScript_Science_Rules {
    lock
    face_player
    msgbox(format("The power of science is amazing!\pNow you can make your very own Pok\emon game!"))
    release
}

##### Blocks path north

script ShaydwellTown_Trigger_BlockPathNorth{
    lock
    msgbox("Hey, kid! It's not safe past here.")
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
        walk_down
    ))
    waitmovement(0)
    release
}