script NicknamePartyMon{
    msgbox("Give it a nickname?", MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
}

script NicknameBoxMon{
    msgbox("Give it a nickname?", MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_NameReceivedBoxMon)
    }
    msgbox("Transferred to PC")
}

text ShaydwellTown_NotChosen{
    "Better leave it then."
}


##### Signposts


script ShaydwellTown_Text_TownSign {
    lockall
    msgbox("Shaydwell Town", MSGBOX_SIGN)
    releaseall
}

script ShaydwellTown_Text_PlayerHouseSign {
    lockall
    msgbox("{PLAYER}'s House", MSGBOX_SIGN)
    releaseall
}

script ShaydwellTown_Text_CodyHouseSign {
    lockall
    msgbox("Cody's House", MSGBOX_SIGN)
    releaseall
}


##### Scripts for the event where your Dad gives you Tyrogue


script ShaydwellTown_Trigger_DadGiveMon1 {
    if(!flag(FLAG_SYS_POKEMON_GET)){
        lock
        applymovement(1, moves(
            face_right
        ))
        msgbox(format("Hey bubby! Did Mom send you out here?"))
        closemessage
        applymovement(LOCALID_PLAYER, moves(
            face_left
        ))
        waitmovement(0)
        msgbox(format("Nevermind the yard work. I've got a surprise for you.\pI think you're finally old enough to have your very own Pok\emon.\pI got this from one of my old construction buddies. He said to give it a good home!"))
        givemon(SPECIES_TYROGUE, 5)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Received Tyrogue!")
            waitfanfare
            call(NicknamePartyMon)
        }
        elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Received Tyrogue!")
            waitfanfare
            call(NicknamePartyMon)
        }
        else{
            hidemonpic
            msgbox("No more room")
        }
            msgbox(format("It feels like just yesterday you were taking your first steps! Time really does fly, huh?\pAnyway, why don't you practice battling against some of the Pok\emon in our backyard?"))
        setflag(FLAG_SYS_POKEMON_GET)
        setvar(VAR_SHAYDWELL_INTRO_STATE, 1)
        waitmessage
        release
        }
    else{
        }
}

