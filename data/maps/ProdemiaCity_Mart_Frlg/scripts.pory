mapscripts ProdemiaCity_Mart_Frlg_MapScripts {
}

raw`
ProdemiaCity_Mart_EventScript_Clerk::
	lock
	faceplayer
	message gText_HowMayIServeYou
	waitmessage
	pokemart ProdemiaCity_Mart_Items
	msgbox gText_PleaseComeAgain
	release
	end

	.align 2
ProdemiaCity_Mart_Items::
	.2byte ITEM_POKE_BALL
	.2byte ITEM_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_NONE
	release
	end`

script ProdemiaCity_Mart_EventScript_OldWoman {
	lock
	faceplayer
	msgbox(format("That new Pok\e Mall is going to put this place out of business!\pI don't want to lose my small corner store."))
	release
}

script ProdemiaCity_Mart_EventScript_Man {
	lock
	faceplayer
	msgbox(format("This Pok\e Mart is having a big liquidation sale before they close.\pI'm taking advantage of the good deals while I can."))
	release
}