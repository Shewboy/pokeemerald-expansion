mapscripts QuayshadeTown_PlayersHouse_1F_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_QUAYSHADE_INTRO_STATE, 0: QuayshadeTown_PlayersHouse_1F_Mom_Go_Help_Dad
        ]
}

script QuayshadeTown_PlayersHouse_1F_Mom_Go_Help_Dad{
    lock
    applymovement(1, moves(
            face_right
    ))
    waitmovement(0)
    msgbox(format("Oh good, {PLAYER}, you're awake."))
    closemessage
    applymovement(LOCALID_PLAYER, moves(
        face_left
    ))
    applymovement(1, moves(
        walk_right * 5
    ))
    waitmovement(0)
    msgbox(format("Your father is in the backyard doing yard work. Why don't you lend him a hand?"))
    setvar(VAR_QUAYSHADE_INTRO_STATE, 1)
    release
}

script QuayshadeTown_PlayersHouse_1F_Trigger_Dont_Leave{
    if (var(VAR_QUAYSHADE_INTRO_STATE) == 1) {
        lock
        applymovement(1, moves(
            face_player
        ))
        msgbox(format("Really? Your dad could use your help!"))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, moves(
            walk_up
        ))
        waitmovement(0)
        release
    }
    else {
    }
}

script QuayshadeTown_PlayersHouse_1F_EventScript_Mom{
    if (var(VAR_QUAYSHADE_INTRO_STATE) == 1) {
        lock
        applymovement(1, moves(
            face_player
        ))
        msgbox(format("Why don't you lend your father a hand?"))
        release
    }
    elif (var(VAR_QUAYSHADE_INTRO_STATE) == 2) {
        lock
        applymovement(1, moves(
            face_player
        ))
        msgbox(format("So, were you surprised? I hope I didn't spoil it!\pDid Dad give you any Pok\e Balls?\pHe must have gotten so worked up that he forgot."))
        giveitem(ITEM_POKE_BALL,5)
        waitfanfare
        msgbox(format("Dad has been trying to get you a Pok\emon for a while now.\pYou deserve it!"))
        setvar(VAR_QUAYSHADE_INTRO_STATE, 3)
        release
    }
    else {
        lock
        applymovement(1, moves(
            face_player
        ))
        msgbox(format("The world is your Cloyster now, honey.\pJust don't forget to call us once in a while, okay?\pAnd be safe!"))
        release
    }
}

script QuayshadeTown_PlayersHouse_1F_Little_Sister{
    lock
    applymovement(2, moves(
        face_player
    ))
    msgbox(format("I saw a rare Pok\emon in our backyard!\pMom doesn't believe me though..."))
    release
}