mapscripts ProdemiaCity_House2_1F_Frlg_MapScripts {
}

script ProdemiaCity_House2_1F_EventScript_FemaleStudent {
    lock
    faceplayer
    msgbox(format("Aren't you a bit young to be in college?"))
    release
}

script ProdemiaCity_House2_1F_EventScript_MaleStudent {
    lock
    faceplayer
    msgbox(format("Moving out of my parents' place was scary at first.\pBut now that I've got the hang of my schedule and made new friends, it ain't so bad!"))
    release
}