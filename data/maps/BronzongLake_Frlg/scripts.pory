mapscripts BronzongLake_Frlg_MapScripts {
}


#### TRAINERS 


# Fisherboy Cody 
script BronzongLake_EventScript_CodyBattle {
    trainerbattle_single(TRAINER_FISHERBOY_CODY, format("Hey, {PLAYER}!\pI'm trying to snag BIG BOB!\pBut so far all I've caught are Chewtle..."), format("Aw, man!"), EventScript_Cody_PostBattle)
    msgbox(format("BIG BOB is a super-strong fish Pok\emon.\pI'm going to catch him someday. You'll see!"))
    release
}

script EventScript_Cody_PostBattle {
    msgbox(format("That was fun! But you didn't see me use BIG BOB...\pWait! I have an idea!\pHow about we each train a bit and then rebattle once we've gotten stronger?\pThen maybe I'll get to show you BIG BOB!"))
    release
}


#### NPCs


# Proud Dad
script BronzongLake_EventScript_ProudDad {
    lock
    msgbox(format("Great job, son! Now let's see a BEAUTIFLY stroke."))
    release
}

# Proud Mom
script BronzongLake_EventScript_ProudMom {
    lock
    faceplayer
    msgbox(format("Our little boy is like a POLIWAG the way he swims.\pBefore we know it, he'll be doing laps - just like his father used to!"))
    release
}

# Tuber
script BronzongLake_EventScript_Tuber {
    lock
    faceplayer
    msgbox(format("Where's your bathing suit?"))
    release
}

# Old Woman
script BronzongLake_EventScript_OldWoman {
    lock
    faceplayer
    msgbox(format("Lots of people my age complain about how rowdy children can be.\pBut not me! It warms my heart to see them enjoying their youth."))
    release
}


#### SIGNPOSTS


# Swim Club
script BronzongLake_Text_SwimClubSign {
    lockall
    msgbox("Bronzong Lake Community Swim Club", MSGBOX_SIGN)
    releaseall
}